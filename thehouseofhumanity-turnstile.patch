+  if (requireTurnstile) {
+    if (!env.TURNSTILE_SECRET_KEY || !turnstileToken || !(await verifyTurnstile(turnstileToken, env.TURNSTILE_SECRET_KEY, ip))) {
+      response.status(403).json({ error: "Please complete the security check and try again." });

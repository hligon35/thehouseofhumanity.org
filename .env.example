# Public deployment
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://thehouseofhumanity.org
ADMIN_BASE_URL=https://thehouseofhumanity.org

# Cloudflare Access / production admin protection
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-audience
ADMIN_ALLOWED_EMAILS=admin@example.org
ALLOW_LOCAL_ADMIN_LOGIN=false

# Local-session fallback secret (only used when local login is enabled)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Scheduled Worker authentication
CRON_PROCESS_SECRET=replace-with-a-long-random-cron-secret

# Resend outbound email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=info@thehouseofhumanity.org
RESEND_REPLY_TO=info@thehouseofhumanity.org
CONTACT_TO_EMAIL=bcharles@thehouseofhumanity.org

# GitHub Actions deployment secrets
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thehouseofhumanity-admin-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "thehouseofhumanity-admin-worker"
    }
  ],
  "routes": [
    {
      "pattern": "thehouseofhumanity.org/admin*",
      "zone_name": "thehouseofhumanity.org"
    },
    {
      "pattern": "thehouseofhumanity.org/api/*",
      "zone_name": "thehouseofhumanity.org"
    },
    {
      "pattern": "www.thehouseofhumanity.org/admin*",
      "zone_name": "thehouseofhumanity.org"
    },
    {
      "pattern": "www.thehouseofhumanity.org/api/*",
      "zone_name": "thehouseofhumanity.org"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "ADMIN_BASE_URL": "https://www.thehouseofhumanity.org"
  },
  "images": {
    "binding": "IMAGES"
  }
}
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thehouseofhumanity",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "thehouseofhumanity"
    }
  ],
  "routes": [
    { "pattern": "thehouseofhumanity.org/*", "zone_name": "thehouseofhumanity.org" },
    { "pattern": "www.thehouseofhumanity.org/*", "zone_name": "thehouseofhumanity.org" }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DASHBOARD_DB",
      "database_name": "thoh-dashboard",
      "database_id": "45724cc1-aa7d-43d4-b3bd-0b78a3a6fd42",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_BASE_URL": "https://thehouseofhumanity.org",
    "NEXT_PUBLIC_SITE_URL": "https://thehouseofhumanity.org",
    "ALLOW_LOCAL_ADMIN_LOGIN": "false",
    "CF_ACCESS_TEAM_DOMAIN": "getsparqd-server.cloudflareaccess.com",
    "CF_ACCESS_AUD": "a9e0f3e69dfc87b96a5b526e50be67584e88ec61176c9f7345de700cba482a04",
    "GOOGLE_CLIENT_ID": "735755043015-8u39d4q9sam2k353kpkfj9ldohmmkdiu.apps.googleusercontent.com",
    "ADMIN_ALLOWED_EMAILS": "hligon@getsparqd.com, bcharles@thehouseofhumanity.org, secretary@thehouseofhumanity.org, housingcoord@thehouseofhumanity.org, treasurer@thehouseofhumanity.org, eventcoord@thehouseofhumanity.org"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}